{
	"name": "bunood-theme",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Build tooling for the Bunood Theme Frappe app. Compiles SCSS to a content-hashed CSS bundle and codegens bunood_theme/assets.py. See ARCHITECTURE.md section 7 for why the build runs on the host rather than via bench build.",
	"scripts": {
		"build": "node build.mjs",
		"watch": "node --watch-path=./bunood_theme/public/scss build.mjs",
		"test": "node tests/smoke.mjs",
		"verify": "node tools/verify.mjs",
		"contrast": "node tools/contrast.mjs",
		"icons:check": "node tools/icons.mjs",
		"i18n:check": "node tools/i18n.mjs check",
		"i18n:list": "node tools/i18n.mjs list",
		"i18n:inherited": "node tools/i18n_inherited.mjs",
		"i18n:emit": "node tools/i18n_po.mjs emit",
		"v1:manifest": "node tools/v1-acceptance-manifest.mjs",
		"v1:authority-map": "node tools/v1-program-authority-map.mjs",
		"v1:edition-gates": "node tools/v1-edition-promotion-gates.mjs",
		"v1:finance-close:contract": "node tools/v1-finance-close-contract.mjs",
		"v1:pdpl:contract": "node tools/v1-pdpl-contract.mjs",
		"v1:saudi-payroll:contract": "node tools/v1-saudi-payroll-contract.mjs",
		"v1:onboarding-migration:contract": "node tools/v1-onboarding-migration-contract.mjs",
		"v1:zatca:contract": "node tools/v1-zatca-contract.mjs",
		"v1:cash-bank-payment:contract": "node tools/v1-cash-bank-payment-contract.mjs",
		"v1:procurement-inventory:contract": "node tools/v1-procurement-inventory-contract.mjs",
		"v1:pos-retail:contract": "node tools/v1-pos-retail-contract.mjs",
		"v1:order-to-cash:contract": "node tools/v1-order-to-cash-contract.mjs",
		"v1:decision-support:contract": "node tools/v1-decision-support-contract.mjs",
		"v1:integration-connector:contract": "node tools/v1-integration-connector-contract.mjs",
		"v1:production-operations:contract": "node tools/v1-production-operations-contract.mjs",
		"v1:performance:plan": "node tools/v1-performance-gate.mjs",
		"v1:performance:gate": "node tools/v1-performance-gate.mjs --require-receipt",
		"v1:pos-role": "node tools/pos-role-permission-acceptance.mjs",
		"v1:item-live": "node tools/form-bilingual-acceptance.mjs && node tools/item-live-acceptance.mjs",
		"v1:stock-entry-live": "node tools/stock-entry-live-acceptance.mjs",
		"release:check": "node tools/release-readiness.mjs",
		"deploy": "bash tools/deploy.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"playwright": "^1.62.1",
		"sass": "^1.80.0"
	}
}
