{
	"name": "bunood-theme",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Build tooling for the Bunood Theme Frappe app. Compiles SCSS to a content-hashed CSS bundle and codegens bunood_theme/assets.py. See ARCHITECTURE.md section 7 for why the build runs on the host rather than via bench build.",
	"scripts": {
		"build": "node build.mjs",
		"watch": "node --watch-path=./bunood_theme/public/scss build.mjs",
		"test": "node tests/smoke.mjs",
		"verify": "node tools/verify.mjs",
		"contrast": "node tools/contrast.mjs",
		"upstream": "node tools/upstream.mjs",
		"icons:check": "node tools/icons.mjs",
		"i18n:check": "node tools/i18n.mjs check",
		"i18n:list": "node tools/i18n.mjs list",
		"i18n:inherited": "node tools/i18n_inherited.mjs",
		"i18n:emit": "node tools/i18n_po.mjs emit",
		"deploy": "bash tools/deploy.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"playwright": "^1.62.1",
		"sass": "^1.80.0"
	}
}
