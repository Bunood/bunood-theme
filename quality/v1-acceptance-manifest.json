  "contracts": {
    "shell": [
      "Exactly one top bar and one navigation owner are visible.",
      "Breadcrumbs, search, sidebar or drawer, and mobile destinations agree with the active route and effective permission.",
      "Unsaved-route handling preserves or deliberately discards the document only after an explicit decision."
    ],
    "form": [
      "The same native document is used by Simple and Advanced modes.",
      "The form follows identity, business context, primary work, totals and validation, and action zones.",
      "Fields align to a shared grid and advanced detail is progressively disclosed without hiding mandatory context."
    ],
    "actions": [
      "One primary action states its outcome and reflects document state and effective permission.",
      "Secondary and dangerous actions are grouped predictably and remain keyboard reachable.",
      "Loading, success, validation, denial, conflict, and failure restore a usable interface and focus."
    ],
    "data-entry": [
      "Names are prominent and identifiers remain available as secondary traceability.",
      "Keyboard, barcode, autocomplete, and row-entry behavior never introduce a second business document model.",
      "Untouched ready rows do not block save, post, totals, or print."
    ],
    "states": [
      "Every applicable declared system state has an explicit consequence and recovery path.",
      "Permission denial is not used for an empty result and integration delay is not described as total offline failure.",
      "Retry is idempotent and cannot duplicate a document, payment, stock move, or integration submission."
    ],
    "visual": [
      "The workspace is neutral-first; dark green is reserved for brand, current selection, primary action, or success.",
      "Ordinary controls are not decorative pills and content is not fragmented into unnecessary cards.",
      "Spacing, alignment, field widths, type hierarchy, and Arabic glyph line height remain coherent at every declared width."
    ],
    "i18n": [
      "All owned static copy is translated and no English label leaks into an Arabic surface or vice versa.",
      "Direction, alignment, icons, arrows, mixed numbers, currency, dates, and truncation work in LTR and RTL.",
      "Business names and source data are not mistranslated merely to make the interface monolingual."
    ],
    "accessibility": [
      "Semantic names, landmarks, headings, labels, focus order, and visible focus are correct.",
      "All core actions work by keyboard and touch without an icon-only mystery action.",
      "Contrast, reduced motion, zoom, and reflow pass the declared surface gate."
    ],
    "permissions": [
      "Presentation is the intersection of the role profile and server-provided permissions.",
      "Each allowed action has a positive server probe and each forbidden action has a negative server probe.",
      "Company, warehouse, POS Profile, and other record scopes include allowed and forbidden fixtures."
    ],
    "reconciliation": [
      "Displayed totals drill to the exact permitted source records.",
      "Authoritative native documents, stock ledger, general ledger, outstanding balances, tax, and reports reconcile where applicable.",
      "Cleanup removes only run-owned fixtures and proves persistent counts are unchanged."
    ]
  },
