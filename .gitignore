# Python — dist/build anchored to the repo ROOT on purpose: an unanchored
# `dist/` would also ignore bunood_theme/public/dist, which must be committed
# (the runtime containers cannot build; see the Node section below).
__pycache__/
*.py[cod]
*.egg-info/
/dist/
/build/

# Node — the toolchain is dev-only; the COMPILED output in
# bunood_theme/public/dist IS committed, because the runtime containers cannot
# build (see ARCHITECTURE.md section 7). The LOCKFILE is committed so CI's
# `npm ci` gate is reproducible.
node_modules/

# Env / editor
.env
.venv
.DS_Store
Thumbs.db

# Agent runtime state
.claude-flow/
.swarm/
ruvector.db*
.claude/settings.local.json

# Read-only reference clones (shallow) — never shipped
_reference/
run.txt

# Local review evidence and agent scratch space. These can contain screenshots,
# exported archives, and third-party reference trees; they are never app assets.
/artifacts/
/work/
