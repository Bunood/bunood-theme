msgstr "لوحة"

#. src: item32
msgid "Split"
msgstr "مُقسَّم"

#. src: item32
msgid "Plate"
msgstr "صفيحة"

#. src: item32
msgid "Sign In Picker"
msgstr "مُنتقي تسجيل الدخول"

#. src: item32
msgid "Set by the picker above. How the sign-in, sign-up and forgot-password screens are composed. Applies to /login and /update-password."
